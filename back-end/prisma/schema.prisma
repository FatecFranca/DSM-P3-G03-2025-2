// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mongodb"
  
}

// Nomes de model no Prisma devem estar
// no singular e iniciar com LetraMaiúscula
model Categoria {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  descricao   String
  produtos    Produto[]
}

model Cliente {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  nome              String
  cpf               String    @unique     // Não pode se repetir na coleção
  data_nascimento   DateTime? // opcional
  senha             String
  email             String    @unique
  admin             Boolean   @default(false)
  celular           String
  mesa_id           String?   @db.ObjectId  // Cliente pode ter uma mesa (opcional)
  mesa              Mesa?     @relation(fields: [mesa_id], references: [id])
}

model Mesa {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  numero            Int           @unique
  capacidade        Int
  status            String
  clientes          Cliente[]     // Uma mesa pode ter vários clientes
  pedidos           Pedido[]
  numero_mesa       Int           @unique
  data_reserva      DateTime?
  total             Float         @default(0)        // Total gasto na mesa
}

model Pedido {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  num_pedido        Int           @unique
  data_hora         DateTime      @default(now())
  mesa_id           String?        @db.ObjectId      // Obrigatório
  mesa              Mesa?          @relation(fields: [mesa_id], references: [id])
  garcom_id         String?       @db.ObjectId      // Opcional
  garcom            Garcom?       @relation(fields: [garcom_id], references: [id])
  valor             Float                           // Valor total do pedido
  pagamento         String        @default("pago")  // Pagamento imediato: "pago"
  status_preparo    String?        @default("aguardando") // Status de preparo: aguardando, em_preparo, pronto, entregue
  itens             ItemPedido[]
  
}

model ItemPedido {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  num_item          Int
  quantidade        Float
  produto_id        String        @db.ObjectId
  produto           Produto       @relation(fields: [produto_id], references: [id])
  pedido_id         String        @db.ObjectId
  pedido            Pedido        @relation(fields: [pedido_id], references: [id])

  // Índice único nos campos pedido_id e num_item para impedir
  // a repetição do número do item dentro do mesmo pedido
  @@unique([pedido_id, num_item])
}

model Garcom {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  nome              String
  cpf               String        @unique
  email             String        @unique
  celular           String
  senha             String
  turno             String
  ativo             Boolean       @default(true)
  pedidos           Pedido[]      // One-to-many: um garçom pode ter muitos pedidos
}

model Produto {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  nome              String
  marca             String
  detalhes          String?
  quantidade        Float
  unidade_medida    String
  preco_unitario    Float
  qtd_estoque       Float
  categoria_id      String        @db.ObjectId
  categoria         Categoria     @relation(fields: [categoria_id], references: [id])
  fornecedores      Fornecedor[]  @relation(fields: [fornecedor_ids], references: [id])
  fornecedor_ids    String[]      @db.ObjectId
  itens_pedido      ItemPedido[]
}

model Fornecedor {
  id                String        @id @default(auto()) @map("_id") @db.ObjectId
  razao_social      String
  nome_fantasia     String?
  cnpj              String        @unique
  email             String        @unique
  logradouro        String
  num_casa          String
  complemento       String?
  bairro            String
  municipio         String
  uf                String
  cep               String
  celular           String
  produtos          Produto[]     @relation(fields: [produto_ids], references: [id])
  produto_ids       String[]      @db.ObjectId
}








